# Copy to .env (never commit it). On GitHub, add the same names as repository secrets.

# Where the SQLite DB and renders live. In the cloud container this is the /data volume.
TFS_DATA_DIR=/data

# --- Brains: Claude ---
# Claude Max subscription (default backend): run `claude setup-token` once, paste the one-year token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional Console API key: used only as a fallback when the subscription's usage window runs out
# (or as the main backend if llm.backend = api in config/channel.yaml).
ANTHROPIC_API_KEY=

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                 # main narrator (Kuya Standard) — Professional Voice Clone recommended
ELEVENLABS_VOICE_JUAN=               # optional character voices for cold-open skits
ELEVENLABS_VOICE_TITO_TRAPO=
FISH_AUDIO_API_KEY=                  # optional cheaper provider
FISH_AUDIO_VOICE_ID=

# --- Images ---
GEMINI_API_KEY=
OPENAI_API_KEY=                      # only if images.provider = openai

# --- Publishing: Post for Me (default publisher for every platform) ---
POSTFORME_API_KEY=                   # project used for Facebook + Instagram ("The Filipino Standard", White Label)
# Per-platform override: TikTok goes through a Quickstart project (Post for Me's approved TikTok app)
POSTFORME_API_KEY_TIKTOK=
# Optional: pin specific connected accounts (otherwise the first connected account per platform is used)
POSTFORME_ACCOUNT_INSTAGRAM=
POSTFORME_ACCOUNT_FACEBOOK=
POSTFORME_ACCOUNT_TIKTOK=

# --- Cloudflare R2: private state backups (+ public media only if publishing.provider = direct) ---
S3_ENDPOINT_URL=                     # e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tfs-media
S3_PUBLIC_BASE_URL=                  # e.g. https://media.thefilipinostandard.com
S3_BACKUP_BUCKET=tfs-backups         # PRIVATE bucket for nightly state backups

# --- YouTube (OAuth "installed app" client + refresh token from `tfs auth youtube`) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=                     # for trend scouting (mostPopular); separate from upload OAuth

# --- Meta (Facebook Page + Instagram professional account linked to it) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=              # long-lived Page token (System User token recommended)
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# --- TikTok (Content Posting API; posts are private until the app passes TikTok's audit) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Reddit (optional trend source; free "script" app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Notifications / approvals (optional; Telegram bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloud VM (GitHub secrets only; used by the deploy/command workflows, not written to .env) ---
VM_HOST=
VM_USER=
VM_SSH_KEY=
