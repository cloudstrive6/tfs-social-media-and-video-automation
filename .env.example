# Copy to .env (never commit it). On GitHub, add the same names as repository secrets.

# Where the SQLite DB and renders live. In the cloud container this is the /data volume.
TFS_DATA_DIR=/data

# --- Brains: Claude ---
# Claude Max subscription (default backend): run `claude setup-token` once, paste the one-year token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional Console API key: used only as a fallback when the subscription's usage window runs out
# (or as the main backend if llm.backend = api in config/channel.yaml).
ANTHROPIC_API_KEY=

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                 # main narrator (Kuya Standard) — Professional Voice Clone recommended
ELEVENLABS_VOICE_JUAN=               # optional character voices for cold-open skits
ELEVENLABS_VOICE_TITO_TRAPO=
FISH_AUDIO_API_KEY=                  # optional cheaper provider
FISH_AUDIO_VOICE_ID=

# --- Images ---
GEMINI_API_KEY=
OPENAI_API_KEY=                      # only if images.provider = openai

# --- TikTok via Post for Me: use the Quickstart project's key (its approved TikTok app posts publicly) ---
POSTFORME_API_KEY=
POSTFORME_ACCOUNT_TIKTOK=            # optional: pin the connected TikTok account id

# --- Cloudflare R2 (optional): private nightly state backups ---
S3_ENDPOINT_URL=                     # e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BACKUP_BUCKET=tfs-backups

# --- YouTube (Google Cloud project "TFS Automation"): uploads + analytics via OAuth; API key for trend scouting ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=                     # for trend scouting (mostPopular); separate from upload OAuth

# --- Meta: Facebook Page + Instagram via the "TFS Auto Poster" app (not TFS Publisher, which Post for Me uses) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=              # long-lived Page token (never expires when made from a long-lived user token)
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0

# --- TikTok direct API (unused; Post for Me handles TikTok) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Reddit (optional trend source; free "script" app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Notifications / approvals (optional; Telegram bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloud VM (GitHub secrets only; used by the deploy/command workflows, not written to .env) ---
VM_HOST=
VM_USER=
VM_SSH_KEY=
