# Asia/Manila time (TZ set in the image). flock -n = never run two copies of the same job;
# producing and publishing are separate locks, so a long render never delays a post.
SHELL=/bin/sh
PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
TFS_DATA_DIR=/data

*/15 * * * *  root  cd /app && flock -n /tmp/tick.lock    python -m tfs.cli tick    >> /proc/1/fd/1 2>&1
*/5  * * * *  root  cd /app && flock -n /tmp/publish.lock python -m tfs.cli publish >> /proc/1/fd/1 2>&1
0    9 * * 1  root  cd /app && flock -n /tmp/analyze.lock python -m tfs.cli analyze >> /proc/1/fd/1 2>&1
30   3 * * *  root  cd /app && python -m tfs.cli backup >> /proc/1/fd/1 2>&1
